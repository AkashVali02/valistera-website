{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "valistera-website",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page"
  },
  "previews": {},
  "build": {
    "command": "node academy/module-2/stamp-build.cjs && node academy/module-3/stamp-build.cjs && node validate-site.cjs"
  }
}
